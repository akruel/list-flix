{
  "name": "list-flix",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "npm run test:unit-ui",
    "test:unit-ui": "vitest run --project unit --project ui --coverage",
    "test:rls": "bash ./scripts/test-rls.sh",
    "test:e2e": "bash ./scripts/test-e2e.sh",
    "test:mutation": "stryker run",
    "db:migration:new": "supabase migration new",
    "db:push": "supabase db push",
    "knip": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lefthook": "lefthook"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
